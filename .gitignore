# Environnements Python
venv/
.venv/
openwebui/.venv-openwebui/
__pycache__/
*.pyc
.pytest_cache/

# Open WebUI : secret de session généré au premier lancement (pas un
# réglage à committer, régénérable sans conséquence), et sa base de données
# (comptes, historique de chat — données personnelles, pas du code).
openwebui/.webui_secret_key
openwebui/data/

# Configuration personnelle (réglages + secrets, ex: jeton Home Assistant) :
# jamais commitée. Seul config.yml.example (le modèle) est versionné.
config.yml

# Modèles téléchargés (gros fichiers binaires, se retéléchargent facilement)
# On garde les dossiers et leur README grâce aux .gitkeep, mais pas leur contenu.
models/**/*.onnx
models/**/*.onnx.json
models/**/*.bin
models/**/*.pt
!models/**/.gitkeep
!models/**/README.md

# Fichiers audio générés pendant les tests manuels
*.wav
*.mp3

# Éditeurs / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Commit installé par install.ps1 (.zip), lu par launch.py
.version
